# Copy to apps/api/.env (must be in this folder — server loads apps/api/.env)

DATABASE_URL="file:./dev.db"

# --- Local model (Ollama) ---
# Native Ollama API (do NOT add /v1):
LOCAL_AI_BASE="http://localhost:11434"
# Must match `ollama list` name exactly, e.g. qwen2.5:7b, llama3.2, etc.
LOCAL_AI_MODEL="qwen2.5:latest"

# OpenAI-compatible local server (LM Studio, LocalAI) — use /v1 suffix:
# LOCAL_AI_BASE="http://127.0.0.1:1234/v1"
# LOCAL_AI_API_KEY=""

# Request timeout (ms)
AI_REQUEST_TIMEOUT_MS=120000

# Automatically summarize older conversation turns before the model context grows too large.
CONTEXT_COMPACT_THRESHOLD_TOKENS=18000
CONTEXT_RECENT_MESSAGES=10

# API port (must match frontend socket: localhost:3003)
API_PORT=3003

# Optional cloud fallback if LOCAL_AI_BASE is unset
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
