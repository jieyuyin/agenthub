# Copy to .env.docker. Do not commit real API keys.
AGENTHUB_WEB_PORT=3000
AGENTHUB_API_PORT=3003
NEXT_PUBLIC_API_URL=http://localhost:3003/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:3003

# OpenAI-compatible provider
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# OpenAI fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local model on the host. Docker Desktop resolves host.docker.internal.
# LOCAL_AI_BASE=http://host.docker.internal:11434
# LOCAL_AI_MODEL=qwen2.5:latest
# LOCAL_AI_API_KEY=

AI_REQUEST_TIMEOUT_MS=120000
CONTEXT_COMPACT_THRESHOLD_TOKENS=18000
CONTEXT_RECENT_MESSAGES=10
