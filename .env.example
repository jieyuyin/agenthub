# ============= Database =============
DATABASE_URL="postgresql://user:password@localhost:5432/agenthub"
DATABASE_SHADOW_URL="postgresql://user:password@localhost:5432/agenthub_shadow"

# ============= Redis =============
REDIS_URL="redis://localhost:6379"

# ============= JWT & Auth =============
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

# ============= OpenAI =============
OPENAI_API_KEY="sk-xxxxxxxxxxxxx"
OPENAI_MODEL="gpt-4"
OPENAI_MODEL_FALLBACK="gpt-3.5-turbo"

# ============= Server Config =============
NODE_ENV="development"
API_PORT="3001"
API_HOST="0.0.0.0"
API_URL="http://localhost:3001"

# ============= Frontend Config =============
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WS_URL="ws://localhost:3001"

# ============= Docker =============
DOCKER_HOST="unix:///var/run/docker.sock"
DOCKER_REGISTRY="docker.io"

# ============= Runtime =============
RUNTIME_IMAGE="node:20-alpine"
RUNTIME_WORKSPACE_ROOT="/workspace"
RUNTIME_MEMORY_LIMIT="2g"
RUNTIME_CPU_LIMIT="2"

# ============= Preview =============
PREVIEW_BASE_URL="http://preview.local"
PREVIEW_PORT="3000"

# ============= Deployment =============
DEPLOYMENT_PROVIDER="vercel" # or "railway"
VERCEL_TOKEN="your-vercel-token"
VERCEL_PROJECT_ID="your-vercel-project-id"
RAILWAY_TOKEN="your-railway-token"

# ============= Logging =============
LOG_LEVEL="debug" # debug, info, warn, error
LOG_FORMAT="json" # json, pretty

# ============= Security =============
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"
BCRYPT_ROUNDS="10"

# ============= Email (Optional) =============
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"

# ============= Feature Flags =============
FEATURE_AUTONOMOUS_AGENTS="false"
FEATURE_SWARM="false"
FEATURE_MARKETPLACE="false"


===local model inference example===
LOCAL_AI_BASE=http://localhost:11434
LOCAL_AI_MODEL=qwen2.5:latest