{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@agenthub/ui": ["packages/ui"],
      "@agenthub/ui/*": ["packages/ui/*"],
      "@agenthub/shared": ["packages/shared"],
      "@agenthub/shared/*": ["packages/shared/*"],
      "@agenthub/ai": ["packages/ai"],
      "@agenthub/ai/*": ["packages/ai/*"],
      "@agenthub/prompts": ["packages/prompts"],
      "@agenthub/prompts/*": ["packages/prompts/*"],
      "@agenthub/agent-runtime": ["packages/agent-runtime"],
      "@agenthub/agent-runtime/*": ["packages/agent-runtime/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
